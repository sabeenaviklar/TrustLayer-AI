# TrustLayer Environment Configuration

# Server & Runtime
NODE_ENV=production
PORT=5001
AI_SERVICE_PORT=8001
CLIENT_PORT=3000

# MongoDB
MONGO_URI=mongodb://mongo:27017/trustlayer

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8001
NLI_MODEL=cross-encoder/nli-deberta-v3-small
CHROMA_PERSIST_DIR=/data/chroma
HF_HOME=/data/models

# JWT Authentication
JWT_SECRET=super_secret_production_ready_jwt_key_at_least_32_chars_12345
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=25

# Razorpay Test Mode / Production (mock mode activated if using rzp_test_mock_*)
RAZORPAY_KEY_ID=rzp_test_mock_key_trustlayer
RAZORPAY_KEY_SECRET=rzp_test_mock_secret_trustlayer
RAZORPAY_WEBHOOK_SECRET=rzp_test_mock_webhook_secret

# Client Build Variables (baked in at build time)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=TrustLayer
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_key_trustlayer
